---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<div id="uploadModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2><i class="fas fa-cloud-upload-alt"></i> Subir Archivo</h2>
      <button class="close-btn" id="closeModal">&times;</button>
    </div>
    
    <div class="modal-body">
      <form id="uploadForm" class="upload-form">
        <input type="hidden" name="path" value={currentPath || '1'} />
        
        <div class="drop-zone" id="dropZone">
          <i class="fas fa-file-upload"></i>
          <p>Arrastra un archivo o haz clic para seleccionar</p>
          <input type="file" name="file" id="fileInput" required hidden />
          <div id="fileName" class="file-name"></div>
        </div>

        <div class="input-group">
          <label for="token"><i class="fab fa-github"></i> GitHub Personal Access Token</label>
          <input type="password" name="token" id="githubToken" placeholder="ghp_xxxxxxxxxxxx" required />
          <div class="input-footer">
            <small>El token se usará solo para esta subida.</small>
            <a href="#" id="tokenHelpLink" class="help-link"><i class="fas fa-question-circle"></i> ¿Qué permisos necesito?</a>
          </div>
        </div>

        <div id="uploadStatus" class="upload-status hidden">
          <div class="progress-bar">
            <div id="progressFill" class="progress-fill"></div>
          </div>
          <p id="statusMessage">Subiendo...</p>
        </div>

        <button type="submit" class="btn btn-primary btn-block" id="submitBtn">
          <i class="fas fa-arrow-up"></i> Iniciar Subida
        </button>
      </form>
    </div>
  </div>
</div>

<!-- Modal de Ayuda de Token -->
<div id="tokenHelpModal" class="modal modal-secondary">
  <div class="modal-content help-content">
    <div class="modal-header">
      <h2><i class="fas fa-key"></i> Configurar Token</h2>
      <button class="close-btn" id="closeHelpModal">&times;</button>
    </div>
    <div class="modal-body">
      <ol class="help-list">
        <li>Ve a <strong>Settings</strong> > <strong>Developer settings</strong> en GitHub.</li>
        <li>Selecciona <strong>Personal access tokens</strong> > <strong>Tokens (classic)</strong>.</li>
        <li>Pulsa en <strong>Generate new token (classic)</strong>.</li>
        <li>Dale un nombre (ej: "Hosted Inled Upload").</li>
        <li>Marca el check principal de <strong>repo</strong> (esto da permisos de lectura/escritura en el repo).</li>
        <li>Copia el token generado y pégalo aquí.</li>
      </ol>
      <div class="help-note">
        <i class="fas fa-info-circle"></i> <strong>Nota:</strong> Si usas un <em>Fine-grained token</em>, asegúrate de dar permisos de <strong>"Contents: Read and Write"</strong> en este repositorio específico.
      </div>
      <button class="btn btn-secondary btn-block" id="closeHelpModalBtn">Entendido</button>
    </div>
  </div>
</div>

<style>
  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(10, 14, 39, 0.85);
    backdrop-filter: blur(8px);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .modal.show {
    display: flex;
  }

  .modal-secondary {
    z-index: 3000;
  }

  .modal-content {
    background: #1a1f3a;
    width: 100%;
    max-width: 500px;
    border-radius: 20px;
    border: 1px solid rgba(61, 182, 255, 0.2);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    animation: modalIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .help-content {
    max-width: 450px;
  }

  @keyframes modalIn {
    from { opacity: 0; transform: translateY(20px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .modal-header {
    padding: 1.5rem 2rem;
    background: linear-gradient(135deg, #1a1f3a 0%, #252b4a 100%);
    border-bottom: 1px solid rgba(61, 182, 255, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal-header h2 {
    color: #fff;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
  }

  .modal-header i {
    color: #3db6ff;
  }

  .close-btn {
    background: none;
    border: none;
    color: #8b92b0;
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
    transition: color 0.2s;
  }

  .close-btn:hover {
    color: #3db6ff;
  }

  .modal-body {
    padding: 2rem;
  }

  .drop-zone {
    border: 2px dashed rgba(61, 182, 255, 0.2);
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-bottom: 1.5rem;
    background: rgba(61, 182, 255, 0.05);
  }

  .drop-zone:hover, .drop-zone.dragover {
    border-color: #3db6ff;
    background: rgba(61, 182, 255, 0.1);
    transform: scale(1.02);
  }

  .drop-zone i {
    font-size: 2.5rem;
    color: #3db6ff;
    margin-bottom: 1rem;
    opacity: 0.6;
  }

  .drop-zone p {
    color: #8b92b0;
    font-size: 0.9rem;
  }

  .file-name {
    margin-top: 1rem;
    color: #fff;
    font-weight: 500;
    font-size: 0.875rem;
  }

  .input-group {
    margin-bottom: 1.5rem;
  }

  .input-group label {
    display: block;
    color: #e4e7f1;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .input-group input {
    width: 100%;
    max-width: 100%;
    background: #0f1420;
    border: 1px solid rgba(61, 182, 255, 0.2);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    color: #fff;
    outline: none;
    transition: all 0.3s ease;
    font-size: 0.9375rem;
  }

  /* Ajuste específico para el token */
  #githubToken {
    max-width: 400px;
    font-family: monospace;
  }

  .input-group input:focus {
    border-color: #3db6ff;
    box-shadow: 0 0 0 3px rgba(61, 182, 255, 0.1);
    background: #1f2540;
  }

  .input-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
  }

  .help-link {
    color: #3db6ff;
    font-size: 0.75rem;
    text-decoration: none;
    transition: opacity 0.2s;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .help-link:hover {
    text-decoration: underline;
    opacity: 0.8;
  }

  .help-list {
    color: #e4e7f1;
    font-size: 0.875rem;
    padding-left: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .help-list li {
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .help-note {
    background: rgba(61, 182, 255, 0.1);
    border-left: 3px solid #3db6ff;
    padding: 0.75rem 1rem;
    color: #8b92b0;
    font-size: 0.8125rem;
    margin-bottom: 1.5rem;
    border-radius: 4px;
  }

  .help-note i {
    color: #3db6ff;
    margin-right: 0.25rem;
  }

  /* Estilos de botones heredados de la UI principal */
  .btn {
    padding: 0.875rem 1.5rem;
    border: none;
    border-radius: 12px;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: all 0.3s ease;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    width: 100%;
  }

  .btn-primary {
    background: #3db6ff;
    color: #fff;
    box-shadow: 0 4px 12px rgba(61, 182, 255, 0.2);
  }

  .btn-primary:hover:not(:disabled) {
    background: #2da3e8;
    box-shadow: 0 8px 20px rgba(61, 182, 255, 0.4);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: rgba(61, 182, 255, 0.1);
    color: #3db6ff;
    border: 1px solid rgba(61, 182, 255, 0.2);
  }

  .btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    background: #4a5172;
    box-shadow: none;
  }

  .input-group small {
    display: block;
    margin-top: 0.5rem;
    color: #6b7396;
    font-size: 0.75rem;
  }

  .btn-block {
    width: 100%;
  }

  .upload-status {
    margin-bottom: 1.5rem;
  }

  .progress-bar {
    width: 100%;
    height: 6px;
    background: #0f1420;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }

  .progress-fill {
    width: 0%;
    height: 100%;
    background: #3db6ff;
    box-shadow: 0 0 10px rgba(61, 182, 255, 0.5);
    transition: width 0.3s ease;
  }

  #statusMessage {
    font-size: 0.8125rem;
    color: #3db6ff;
    text-align: center;
  }

  .hidden {
    display: none;
  }
</style>

<!-- Modal de Actualización de Hostify -->
<div id="updateHostifyModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2><i class="fas fa-sync-alt"></i> Actualizar Hostify</h2>
      <button class="close-btn" id="closeUpdateModal">&times;</button>
    </div>
    <div class="modal-body">
      <form id="updateHostifyForm" class="upload-form">
        <div class="help-note" style="margin-bottom: 1.5rem;">
          <i class="fas fa-exclamation-triangle"></i> <strong>Atención:</strong> Esta acción reemplazará el código fuente del motor. La carpeta <code>public/</code> no se verá afectada. Solo funciona en modo <strong>npm run dev</strong>.
        </div>
        
        <div class="drop-zone" id="updateDropZone">
          <i class="fas fa-file-archive"></i>
          <p>Sube el archivo <code>Hostify.zip</code> para actualizar</p>
          <input type="file" name="zip" id="zipInput" accept=".zip" required hidden />
          <div id="zipName" class="file-name"></div>
        </div>

        <div id="updateStatus" class="upload-status hidden">
          <div class="progress-bar">
            <div id="updateProgressFill" class="progress-fill"></div>
          </div>
          <p id="updateStatusMessage">Procesando actualización...</p>
        </div>

        <button type="submit" class="btn btn-primary btn-block" id="confirmUpdateBtn">
          <i class="fas fa-magic"></i> Ejecutar Actualización
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  import { actions } from 'astro:actions';

  const modal = document.getElementById('uploadModal');
  const updateModal = document.getElementById('updateHostifyModal');
  const closeBtn = document.getElementById('closeModal');
  const closeUpdateBtn = document.getElementById('closeUpdateModal');
  
  // Elementos actualización
  const updateForm = document.getElementById('updateHostifyForm') as HTMLFormElement;
  const zipInput = document.getElementById('zipInput') as HTMLInputElement;
  const zipNameDisplay = document.getElementById('zipName');
  const updateDropZone = document.getElementById('updateDropZone');
  const updateStatusDiv = document.getElementById('updateStatus');
  const updateProgressFill = document.getElementById('updateProgressFill');
  const updateStatusMessage = document.getElementById('updateStatusMessage');
  const confirmUpdateBtn = document.getElementById('confirmUpdateBtn') as HTMLButtonElement;

  // Elementos subida estándar
  const uploadForm = document.getElementById('uploadForm') as HTMLFormElement;
  const fileInput = document.getElementById('fileInput') as HTMLInputElement;
  const fileNameDisplay = document.getElementById('fileName');
  const dropZone = document.getElementById('dropZone');
  const statusDiv = document.getElementById('uploadStatus');
  const progressFill = document.getElementById('progressFill') as HTMLElement;
  const statusMessage = document.getElementById('statusMessage');
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

  // Abrir modal (desde botón externo)
  document.getElementById('openUploadBtn')?.addEventListener('click', () => {
    modal?.classList.add('show');
  });

  document.getElementById('openUpdateHostifyBtn')?.addEventListener('click', () => {
    updateModal?.classList.add('show');
  });

  // Cerrar modales
  [closeBtn, closeUpdateBtn].forEach(btn => {
    btn?.addEventListener('click', () => {
      modal?.classList.remove('show');
      updateModal?.classList.remove('show');
    });
  });

  // Lógica de archivos para actualización
  updateDropZone?.addEventListener('click', () => zipInput?.click());
  zipInput?.addEventListener('change', () => {
    if (zipInput.files?.length) {
      zipNameDisplay!.textContent = `Seleccionado: ${zipInput.files[0].name}`;
    }
  });

  updateForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(updateForm);
    confirmUpdateBtn.disabled = true;
    updateStatusDiv?.classList.remove('hidden');
    updateProgressFill!.style.width = '50%';

    const { data, error } = await actions.updateHostify(formData);

    if (error) {
      updateStatusMessage!.textContent = `Error: ${error.message}`;
      updateStatusMessage!.style.color = '#ff4d4d';
      confirmUpdateBtn.disabled = false;
    } else if (data?.success) {
      updateProgressFill!.style.width = '100%';
      updateStatusMessage!.textContent = '¡Hostify actualizado! Reiniciando...';
      setTimeout(() => window.location.reload(), 2000);
    } else {
      updateStatusMessage!.textContent = `Error: ${data?.error || 'Error desconocido'}`;
      updateStatusMessage!.style.color = '#ff4d4d';
      confirmUpdateBtn.disabled = false;
    }
  });

  // Modal de Ayuda
  const helpModal = document.getElementById('tokenHelpModal');
  const helpLink = document.getElementById('tokenHelpLink');
  const closeHelpModal = document.getElementById('closeHelpModal');
  const closeHelpBtn = document.getElementById('closeHelpModalBtn');

  helpLink?.addEventListener('click', (e) => {
    e.preventDefault();
    helpModal?.classList.add('show');
  });

  [closeHelpModal, closeHelpBtn].forEach(btn => {
    btn?.addEventListener('click', () => helpModal?.classList.remove('show'));
  });

  // Drag & Drop
  dropZone?.addEventListener('click', () => fileInput?.click());
  dropZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('dragover');
  });
  dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    if (e.dataTransfer?.files.length) {
      fileInput.files = e.dataTransfer.files;
      updateFileName();
    }
  });

  fileInput?.addEventListener('change', updateFileName);

  function updateFileName() {
    if (fileInput.files?.length) {
      fileNameDisplay!.textContent = `Seleccionado: ${fileInput.files[0].name}`;
    }
  }

  function resetForm() {
    uploadForm.reset();
    fileNameDisplay!.textContent = '';
    statusDiv?.classList.add('hidden');
    submitBtn.disabled = false;
    progressFill!.style.width = '0%';
  }

  // Enviar formulario (Directo a GitHub para evitar límites de 1MB en el servidor)
  uploadForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const file = fileInput.files?.[0];
    const token = (document.getElementById('githubToken') as HTMLInputElement).value;
    const path = (uploadForm.querySelector('input[name="path"]') as HTMLInputElement).value;
    const repo = 'InledGroup/hosted.inled.es';
    
    if (!file || !token) return;

    submitBtn.disabled = true;
    statusDiv?.classList.remove('hidden');
    
    progressFill!.style.width = '20%';
    statusMessage!.textContent = 'Codificando archivo...';

    try {
      // Convertir a Base64 en el cliente
      const base64 = await new Promise<string>((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => {
          const result = reader.result as string;
          resolve(result.split(',')[1]); // Quitar el prefijo data:...;base64,
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });

      progressFill!.style.width = '50%';
      statusMessage!.textContent = 'Subiendo a GitHub...';

      // Nombre del archivo sanitizado (reemplazar espacios por guiones)
      const fileName = file.name.replace(/\s+/g, '-');
      const finalPath = `public/${path}/${fileName}`;

      // 1. Verificar si el archivo ya existe para obtener el SHA (opcional para subir nuevo, necesario para sobrescribir)
      // Por ahora intentamos subir directamente como nuevo archivo
      
      const response = await fetch(`https://api.github.com/repos/${repo}/contents/${finalPath}`, {
        method: 'PUT',
        headers: {
          'Authorization': `token ${token}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          message: `Upload ${fileName} via Hosted Inled UI`,
          content: base64,
          branch: 'main' // Asegúrate de que esta sea tu rama principal
        })
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.message || 'Error al subir a GitHub');
      }

      progressFill!.style.width = '100%';
      statusMessage!.textContent = '¡Subida completada con éxito!';
      statusMessage!.style.color = '#3db6ff';
      
      if ((window as any).showToast) {
        (window as any).showToast('<i class="fas fa-check-circle"></i> Archivo subido al repositorio');
      }

      setTimeout(() => {
        modal?.classList.remove('show');
        window.location.reload();
      }, 1500);

    } catch (error: any) {
      statusMessage!.textContent = `Error: ${error.message}`;
      statusMessage!.style.color = '#ff4d4d';
      progressFill!.style.backgroundColor = '#ff4d4d';
      submitBtn.disabled = false;
      console.error('Upload Error:', error);
    }
  });
</script>
