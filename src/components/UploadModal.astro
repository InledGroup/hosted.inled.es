---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<div id="uploadModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2><i class="fas fa-cloud-upload-alt"></i> Subir Archivos</h2>
      <button class="close-btn" id="closeModal">&times;</button>
    </div>

    <div class="modal-body">
      <form id="uploadForm" class="upload-form">
        <input type="hidden" name="path" value={currentPath || '1'} />

        <div class="drop-zone" id="dropZone">
          <i class="fas fa-file-upload"></i>
          <p>Arrastra uno o varios archivos o haz clic para seleccionar</p>
          <small>Imágenes, GIFs y vídeos. Todo se sube como Release Asset de GitHub (hasta 2 GB por archivo).</small>
          <input type="file" name="file" id="fileInput" multiple hidden />
        </div>

        <div id="fileList" class="file-list hidden"></div>

        <div class="input-group">
          <label for="token"><i class="fab fa-github"></i> GitHub Personal Access Token</label>
          <input type="password" name="token" id="githubToken" placeholder="ghp_xxxxxxxxxxxx" required />
          <div class="input-footer">
            <small>El token se usará solo para esta subida.</small>
            <a href="#" id="tokenHelpLink" class="help-link"><i class="fas fa-question-circle"></i> ¿Qué permisos necesito?</a>
          </div>
        </div>

        <div id="uploadStatus" class="upload-status hidden">
          <div class="progress-bar">
            <div id="progressFill" class="progress-fill"></div>
          </div>
          <p id="statusMessage">Subiendo...</p>
        </div>

        <button type="submit" class="btn btn-primary btn-block" id="submitBtn" disabled>
          <i class="fas fa-arrow-up"></i> Iniciar Subida
        </button>
      </form>
    </div>
  </div>
</div>

<!-- Modal de Ayuda de Token -->
<div id="tokenHelpModal" class="modal modal-secondary">
  <div class="modal-content help-content">
    <div class="modal-header">
      <h2><i class="fas fa-key"></i> Configurar Token</h2>
      <button class="close-btn" id="closeHelpModal">&times;</button>
    </div>
    <div class="modal-body">
      <ol class="help-list">
        <li>Ve a <strong>Settings</strong> > <strong>Developer settings</strong> en GitHub.</li>
        <li>Selecciona <strong>Personal access tokens</strong> > <strong>Tokens (classic)</strong>.</li>
        <li>Pulsa en <strong>Generate new token (classic)</strong>.</li>
        <li>Dale un nombre (ej: "Hosted Inled Upload").</li>
        <li>Marca el check principal de <strong>repo</strong> (lectura/escritura del repo) y el de <strong>workflow</strong> (para refrescar automáticamente el listado de archivos al terminar la subida).</li>
        <li>Copia el token generado y pégalo aquí.</li>
      </ol>
      <div class="help-note">
        <i class="fas fa-info-circle"></i> <strong>Nota:</strong> Si usas un <em>Fine-grained token</em>, asegúrate de dar permisos de <strong>"Contents: Read and Write"</strong> y <strong>"Actions: Read and Write"</strong> en este repositorio específico (necesario para crear/llenar la Release de assets y disparar el Action que regenera el índice).
      </div>
      <button class="btn btn-secondary btn-block" id="closeHelpModalBtn">Entendido</button>
    </div>
  </div>
</div>

<style>
  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(4px);
    z-index: 2000;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .modal.show {
    display: flex;
  }

  .modal-secondary {
    z-index: 3000;
  }

  .modal-content {
    background: #ffffff;
    width: 100%;
    max-width: 540px;
    border-radius: 0.75rem;
    border: 1px solid var(--border, #e2e8f0);
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.2);
    overflow: hidden;
    animation: modalIn 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .help-content {
    max-width: 450px;
  }

  @keyframes modalIn {
    from { opacity: 0; transform: translateY(12px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .modal-header {
    padding: 1.25rem 1.5rem;
    background: #ffffff;
    border-bottom: 1px solid var(--border, #e2e8f0);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal-header h2 {
    color: var(--foreground, #0f172a);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .modal-header i {
    color: var(--muted-2, #94a3b8);
  }

  .close-btn {
    background: none;
    border: none;
    color: var(--muted-2, #94a3b8);
    font-size: 1.5rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    transition: all 0.15s;
  }

  .close-btn:hover {
    background: var(--accent, #f1f5f9);
    color: var(--foreground, #0f172a);
  }

  .modal-body {
    padding: 1.5rem;
  }

  .drop-zone {
    border: 2px dashed var(--border, #cbd5e1);
    border-radius: 0.625rem;
    padding: 1.5rem 1rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-bottom: 1.25rem;
    background: var(--bg, #f8fafc);
  }

  .drop-zone:hover, .drop-zone.dragover {
    border-color: var(--foreground, #0f172a);
    background: var(--accent, #f1f5f9);
  }

  .drop-zone i {
    font-size: 2.25rem;
    color: var(--muted-2, #94a3b8);
    margin-bottom: 0.75rem;
  }

  .drop-zone p {
    color: var(--muted, #64748b);
    font-size: 0.875rem;
    margin-bottom: 0.375rem;
  }

  .drop-zone small {
    color: var(--muted-2, #94a3b8);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .file-list {
    background: var(--bg, #f8fafc);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 0.625rem;
    padding: 0.5rem;
    margin-bottom: 1.5rem;
    max-height: 180px;
    overflow-y: auto;
  }

  .file-list-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    color: var(--foreground, #0f172a);
  }

  .file-list-item:hover {
    background: #ffffff;
  }

  .file-list-item .fname {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .file-list-item .fname i {
    color: var(--muted, #64748b);
  }

  .file-list-item .fname span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .file-list-item .badge {
    font-size: 0.6875rem;
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    font-weight: 600;
    white-space: nowrap;
  }

  .badge-release {
    background: #fff7ed;
    border: 1px solid #fed7aa;
    color: #9a3412;
  }

  .remove-file {
    background: none;
    border: none;
    color: var(--muted-2, #94a3b8);
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 4px;
    transition: all 0.15s;
  }

  .remove-file:hover {
    color: #dc2626;
  }

  .input-group {
    margin-bottom: 1.5rem;
  }

  .input-group label {
    display: block;
    color: var(--muted, #64748b);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .input-group label i {
    margin-right: 0.25rem;
  }

  .input-group input {
    width: 100%;
    max-width: 100%;
    height: 2.75rem;
    padding: 0 1rem;
    background: #ffffff;
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 0.5rem;
    color: var(--foreground, #0f172a);
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    font-size: 0.875rem;
    font-family: inherit;
  }

  #githubToken {
    max-width: 400px;
    font-family: monospace;
  }

  .input-group input::placeholder {
    color: var(--muted-2, #94a3b8);
  }

  .input-group input:focus {
    border-color: var(--foreground, #0f172a);
    box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.08);
  }

  .input-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.625rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .input-footer small {
    color: var(--muted-2, #94a3b8);
    font-size: 0.75rem;
  }

  .help-link {
    color: #2563eb;
    font-size: 0.75rem;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .help-link:hover {
    text-decoration: underline;
  }

  .help-list {
    color: var(--foreground, #0f172a);
    font-size: 0.875rem;
    padding-left: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .help-list li {
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }

  .help-note {
    background: var(--bg, #f8fafc);
    border-left: 3px solid #2563eb;
    padding: 0.75rem 1rem;
    color: var(--muted, #64748b);
    font-size: 0.8125rem;
    margin-bottom: 1.5rem;
    border-radius: 4px;
  }

  .help-note i {
    color: #2563eb;
    margin-right: 0.25rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0 1rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    font-size: 0.875rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
    width: 100%;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--primary, #0f172a);
    color: #ffffff;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--primary-hover, #1e293b);
  }

  .btn-secondary {
    background: transparent;
    border-color: var(--border, #e2e8f0);
    color: #334155;
  }

  .btn-secondary:hover {
    background: var(--accent, #f1f5f9);
  }

  .btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn-block {
    width: 100%;
  }

  .upload-status {
    margin-bottom: 1.5rem;
  }

  .progress-bar {
    width: 100%;
    height: 6px;
    background: var(--accent, #f1f5f9);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }

  .progress-fill {
    width: 0%;
    height: 100%;
    background: var(--primary, #0f172a);
    border-radius: 999px;
    transition: width 0.3s ease;
  }

  #statusMessage {
    font-size: 0.8125rem;
    color: #475569;
    text-align: center;
  }

  .hidden {
    display: none;
  }
</style>

<script>
  const modal = document.getElementById('uploadModal');
  const closeBtn = document.getElementById('closeModal');

  const uploadForm = document.getElementById('uploadForm') as HTMLFormElement;
  const fileInput = document.getElementById('fileInput') as HTMLInputElement;
  const fileList = document.getElementById('fileList');
  const dropZone = document.getElementById('dropZone');
  const statusDiv = document.getElementById('uploadStatus');
  const progressFill = document.getElementById('progressFill') as HTMLElement;
  const statusMessage = document.getElementById('statusMessage');
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

  const repo = 'InledGroup/hosted.inled.es';
  const ASSET_RELEASE_TAG = 'assets';
  const ASSETS_PER_RELEASE_LIMIT = 1000; // Cap de GitHub: máx. 1000 assets por release
  const RELEASE_LIMIT = 2 * 1024 * 1024 * 1024; // 2 GB (límite GitHub Release Asset)
  const WORKFLOW_ID = 'assets-index.yml'; // Regenera el índice estático de assets

  let selectedFiles: File[] = [];

  function formatBytes(bytes: number): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return (Math.round(bytes / Math.pow(k, i) * 100) / 100) + ' ' + sizes[i];
  }

  function sanitizeName(name: string): string {
    return name.replace(/\s+/g, '-');
  }

  function isTooBig(file: File): boolean {
    return file.size > RELEASE_LIMIT;
  }

  function fileIcon(name: string): string {
    const ext = '.' + (name.split('.').pop() || '').toLowerCase();
    const icons: Record<string, string> = {
      '.mp4': 'fa-file-video', '.mov': 'fa-file-video', '.webm': 'fa-file-video',
      '.mkv': 'fa-file-video', '.avi': 'fa-file-video', '.gif': 'fa-file-image',
      '.png': 'fa-file-image', '.jpg': 'fa-file-image', '.jpeg': 'fa-file-image',
      '.webp': 'fa-file-image', '.mp3': 'fa-file-audio', '.wav': 'fa-file-audio'
    };
    return icons[ext] || 'fa-file';
  }

  function renderFileList() {
    if (selectedFiles.length === 0) {
      fileList?.classList.add('hidden');
      fileList!.innerHTML = '';
      submitBtn.disabled = true;
      return;
    }
    const hasTooBig = selectedFiles.some(isTooBig);
    submitBtn.disabled = hasTooBig;
    fileList!.classList.remove('hidden');
    fileList!.innerHTML = selectedFiles.map((f, idx) => {
      const badge = isTooBig(f)
        ? '<span class="badge badge-release" style="background:#fef2f2; border-color:#fecaca; color:#dc2626;" title="Máx. 2 GB por archivo"><i class="fas fa-exclamation-triangle"></i> &gt;2 GB</span>'
        : '<span class="badge badge-release"><i class="fas fa-rocket"></i> Release</span>';
      return `
        <div class="file-list-item" data-idx="${idx}">
          <div class="fname">
            <i class="fas ${fileIcon(f.name)}"></i>
            <span title="${f.name}">${f.name}</span>
            <small style="color:var(--muted-2,#94a3b8); white-space:nowrap;">(${formatBytes(f.size)})</small>
          </div>
          <div style="display:flex; align-items:center; gap:0.5rem;">
            ${badge}
            <button type="button" class="remove-file" data-remove="${idx}" title="Quitar">
              <i class="fas fa-times"></i>
            </button>
          </div>
        </div>`;
    }).join('');
  }

  dropZone?.addEventListener('click', () => fileInput?.click());
  dropZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('dragover');
  });
  dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    if (e.dataTransfer?.files?.length) {
      selectedFiles = selectedFiles.concat(Array.from(e.dataTransfer.files));
      renderFileList();
    }
  });

  fileInput?.addEventListener('change', () => {
    if (fileInput.files?.length) {
      selectedFiles = selectedFiles.concat(Array.from(fileInput.files));
      renderFileList();
    }
    fileInput.value = '';
  });

  fileList?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-remove]') as HTMLElement | null;
    if (btn) {
      const idx = Number(btn.dataset.remove);
      selectedFiles = selectedFiles.filter((_, i) => i !== idx);
      renderFileList();
    }
  });

  // Abrir/cerrar modal
  document.getElementById('openUploadBtn')?.addEventListener('click', () => {
    modal?.classList.add('show');
  });

  closeBtn?.addEventListener('click', () => {
    modal?.classList.remove('show');
    resetForm();
  });

  // Modal de Ayuda
  const helpModal = document.getElementById('tokenHelpModal');
  const helpLink = document.getElementById('tokenHelpLink');
  const closeHelpModal = document.getElementById('closeHelpModal');
  const closeHelpBtn = document.getElementById('closeHelpModalBtn');

  helpLink?.addEventListener('click', (e) => {
    e.preventDefault();
    helpModal?.classList.add('show');
  });

  [closeHelpModal, closeHelpBtn].forEach(btn => {
    btn?.addEventListener('click', () => helpModal?.classList.remove('show'));
  });

  function resetForm() {
    selectedFiles = [];
    renderFileList();
    uploadForm.reset();
    statusDiv?.classList.add('hidden');
    submitBtn.disabled = true;
    progressFill!.style.width = '0%';
    statusMessage!.style.color = '';
    progressFill!.style.backgroundColor = '';
  }

  // --- Helpers de la API de GitHub ---
  function authHeaders(token: string) {
    return { 'Authorization': `token ${token}`, 'Accept': 'application/vnd.github+json' };
  }

  async function listReleases(token: string): Promise<any[]> {
    const res = await fetch(`https://api.github.com/repos/${repo}/releases?per_page=100`, { headers: authHeaders(token) });
    if (!res.ok) throw new Error('No se pudieron listar las releases (¿permiso "repo"?).');
    return res.json();
  }

  async function listAssets(releaseId: number, token: string): Promise<any[]> {
    const all: any[] = [];
    let page = 1;
    while (true) {
      const res = await fetch(`https://api.github.com/repos/${repo}/releases/${releaseId}/assets?per_page=100&page=${page}`, { headers: authHeaders(token) });
      if (!res.ok) throw new Error('No se pudieron listar los assets de la release.');
      const list = await res.json();
      all.push(...list);
      if (list.length < 100) break;
      page += 1;
    }
    return all;
  }

  // Elige la release de assets adecuada (rotación automática al llegar a 1000 assets)
  async function getOrCreateAssetsRelease(token: string): Promise<any> {
    const releases = await listReleases(token);
    const assetReleases = releases.filter(r =>
      r.tag_name === ASSET_RELEASE_TAG || /^assets-\d+$/.test(r.tag_name)
    );

    for (const rel of assetReleases) {
      const assets = await listAssets(rel.id, token);
      if (assets.length < ASSETS_PER_RELEASE_LIMIT) return rel;
    }

    // Todas llenas: creamos la siguiente (assets, assets-2, assets-3, …)
    let maxNum = assetReleases.some(r => r.tag_name === ASSET_RELEASE_TAG) ? 1 : 0;
    assetReleases.forEach(r => {
      const m = /^assets-(\d+)$/.exec(r.tag_name);
      if (m) maxNum = Math.max(maxNum, Number(m[1]));
    });
    const nextTag = maxNum >= 1 ? `${ASSET_RELEASE_TAG}-${maxNum + 1}` : ASSET_RELEASE_TAG;

    const res = await fetch(`https://api.github.com/repos/${repo}/releases`, {
      method: 'POST',
      headers: { ...authHeaders(token), 'Content-Type': 'application/json' },
      body: JSON.stringify({
        tag_name: nextTag,
        name: `Hostify Assets (archivos grandes) ${nextTag === 'assets' ? '' : '- ' + nextTag}`.trim(),
        body: 'Release utilizada por la interfaz de Hostify para alojar imágenes, GIFs y vídeos.',
        draft: false,
        prerelease: false
      })
    });
    if (!res.ok) {
      const err = await res.json();
      throw new Error(err.message || 'Error al crear la release de assets.');
    }
    return res.json();
  }

  // --- Upload a Release Asset (hasta 2 GB, body binario directo) ---
  async function uploadToRelease(file: File, token: string): Promise<string> {
    const release = await getOrCreateAssetsRelease(token);
    const fileName = sanitizeName(file.name);

    // Si ya existe un asset con ese nombre, lo reemplazamos (GitHub no permite duplicados)
    const existing = await listAssets(release.id, token);
    const dup = existing.find(a => a.name === fileName);
    if (dup) {
      const del = await fetch(`https://api.github.com/repos/${repo}/releases/assets/${dup.id}`, {
        method: 'DELETE',
        headers: authHeaders(token)
      });
      if (!del.ok) throw new Error('No se pudo reemplazar el asset existente.');
    }

    const uploadUrl = release.upload_url.replace('{?name,label}', '');
    const url = `${uploadUrl}?name=${encodeURIComponent(fileName)}`;

    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Authorization': `token ${token}`,
        'Content-Type': file.type || 'application/octet-stream'
      },
      body: file
    });

    if (!response.ok) {
      const err = await response.json();
      throw new Error(err.message || 'Error al subir el asset a la release.');
    }
    const asset = await response.json();
    return asset.browser_download_url || '';
  }

  // --- Dispara el Action que regenera el índice estático (mejor esfuerzo) ---
  async function dispatchIndexSync(token: string): Promise<boolean> {
    try {
      const res = await fetch(`https://api.github.com/repos/${repo}/actions/workflows/${WORKFLOW_ID}/dispatches`, {
        method: 'POST',
        headers: { ...authHeaders(token), 'Content-Type': 'application/json' },
        body: JSON.stringify({ ref: 'main' })
      });
      if (!res.ok) {
        console.warn('No se pudo disparar el Action de índice (requiere permiso "workflow"):', res.status);
        return false;
      }
      return true;
    } catch (e) {
      console.warn('No se pudo disparar el Action de índice:', e);
      return false;
    }
  }

  // --- Envío principal ---
  uploadForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const token = (document.getElementById('githubToken') as HTMLInputElement).value.trim();
    if (selectedFiles.length === 0 || !token) return;
    if (selectedFiles.some(isTooBig)) {
      statusDiv?.classList.remove('hidden');
      statusMessage!.textContent = 'Un archivo supera el límite de 2 GB por archivo.';
      statusMessage!.style.color = '#dc2626';
      submitBtn.disabled = false;
      return;
    }

    submitBtn.disabled = true;
    statusDiv?.classList.remove('hidden');
    statusMessage!.textContent = 'Subiendo...';
    statusMessage!.style.color = '';
    progressFill!.style.width = '0%';
    progressFill!.style.backgroundColor = '';

    const uploaded: string[] = [];
    let done = 0;

    try {
      for (const file of selectedFiles) {
        statusMessage!.textContent = `Subiendo ${file.name}...`;
        const url = await uploadToRelease(file, token);
        uploaded.push(url);
        done += 1;
        progressFill!.style.width = `${Math.round((done / selectedFiles.length) * 100)}%`;
      }

      // Nota: el índice estático se regenera vía GH Action (workflow_dispatch o cron cada 30 min)
      statusMessage!.textContent = 'Subidas completas. Actualizando el índice...';
      const synced = await dispatchIndexSync(token);

      progressFill!.style.width = '100%';
      statusMessage!.textContent = synced
        ? `¡${uploaded.length} archivo(s) subido(s)! El índice se actualizará en breve.`
        : `¡${uploaded.length} archivo(s) subido(s)! El índice se actualizará vía el Action automático (máx. 30 min).`;
      statusMessage!.style.color = '#16a34a';

      if ((window as any).showToast) {
        (window as any).showToast(`<i class="fas fa-check-circle"></i> ${uploaded.length} archivo(s) subido(s) a GitHub Releases`);
      }

      setTimeout(() => {
        modal?.classList.remove('show');
        window.location.reload();
      }, 2000);
    } catch (error: any) {
      statusMessage!.textContent = `Error: ${error.message}`;
      statusMessage!.style.color = '#dc2626';
      progressFill!.style.backgroundColor = '#dc2626';
      submitBtn.disabled = false;
      console.error('Upload Error:', error);
    }
  });
</script>