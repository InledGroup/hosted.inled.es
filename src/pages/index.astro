---
import fileIndex from '../data/file-index.json';
import UploadModal from '../components/UploadModal.astro';

export const prerender = true;

// Ya no filtramos en el servidor, solo pasamos el índice al cliente
const allItems = fileIndex;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hostify</title>
    <link rel="icon" type="image/png" href="/hostify.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style is:global>
      :root {
        --bg: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;
        --foreground: #0f172a;
        --muted: #64748b;
        --muted-2: #94a3b8;
        --accent: #f1f5f9;
        --primary: #0f172a;
        --primary-hover: #1e293b;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        background-color: var(--bg);
        color: var(--foreground);
        -webkit-font-smoothing: antialiased;
      }

      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background: var(--bg);
        line-height: 1.6;
        min-height: 100vh;
      }

      a {
        color: #2563eb;
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        min-height: 100vh;
      }

      .header {
        background: #fff;
        border-bottom: 1px solid var(--border);
        padding: 1.25rem 2rem;
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .header-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 0.75rem;
      }

      .header h1 {
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        color: var(--foreground);
        display: flex;
        align-items: center;
        gap: 0.625rem;
      }

      .header h1 img {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        object-fit: cover;
      }

      .header-actions {
        display: flex;
        gap: 0.625rem;
        align-items: center;
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        flex-wrap: wrap;
        font-size: 0.8125rem;
        color: var(--muted);
      }

      .breadcrumb a {
        color: var(--muted);
        text-decoration: none;
        padding: 0.3rem 0.625rem;
        border-radius: 6px;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        cursor: pointer;
      }

      .breadcrumb a:hover {
        background: var(--accent);
        color: var(--foreground);
        text-decoration: none;
      }

      .breadcrumb .separator {
        color: var(--muted-2);
        font-size: 0.625rem;
      }

      .search-container {
        padding: 1.25rem 2rem 0;
        background: var(--bg);
      }

      .search-wrapper {
        position: relative;
        max-width: 100%;
      }

      .search-wrapper i {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--muted-2);
        font-size: 0.875rem;
        pointer-events: none;
      }

      .search-input {
        width: 100%;
        height: 2.75rem;
        padding: 0 1rem 0 2.75rem;
        font-size: 0.875rem;
        font-family: inherit;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        color: var(--foreground);
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }

      .search-input::placeholder {
        color: var(--muted-2);
      }

      .search-input:focus {
        border-color: var(--foreground);
        box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.08);
      }

      .content {
        padding: 1.25rem 2rem 3rem;
      }

      .items-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.25rem;
      }

      .item {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        overflow: hidden;
        transition: box-shadow 0.2s ease, border-color 0.2s ease;
        display: flex;
        flex-direction: column;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      }

      .item:hover {
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        border-color: #cbd5e1;
      }

      .item.hidden {
        display: none;
      }

      .item-preview {
        width: 100%;
        height: 190px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--accent);
        overflow: hidden;
        position: relative;
        border-bottom: 1px solid var(--border);
      }

      .item-preview img,
      .item-preview video {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        width: 100%;
        height: 100%;
      }

      .folder-icon,
      .file-icon {
        font-size: 3rem;
        color: var(--muted-2);
      }

      .item-body {
        padding: 1rem 1.25rem 1.25rem;
        flex: 1;
        display: flex;
        flex-direction: column;
      }

      .item-info {
        flex: 1;
        margin-bottom: 0.875rem;
      }

      .item-name {
        font-weight: 600;
        font-size: 0.875rem;
        color: var(--foreground);
        margin-bottom: 0.375rem;
        word-break: break-word;
        line-height: 1.4;
      }

      .item-details {
        font-size: 0.75rem;
        color: var(--muted);
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.375rem;
      }

      .release-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #9a3412;
        font-weight: 600;
        padding: 0.125rem 0.5rem;
        border-radius: 999px;
        font-size: 0.6875rem;
      }

      .item-actions {
        display: flex;
        gap: 0.5rem;
      }

      .item-actions .btn {
        flex: 1;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0 0.875rem;
        height: 2.25rem;
        border-radius: 0.5rem;
        border: 1px solid transparent;
        font-size: 0.8125rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: none;
        text-decoration: none;
      }

      .btn i {
        font-size: 0.75rem;
      }

      .btn-primary {
        background: var(--primary);
        color: #fff;
      }

      .btn-primary:hover {
        background: var(--primary-hover);
        color: #fff;
        text-decoration: none;
      }

      .btn-primary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .btn-outline {
        background: transparent;
        border-color: var(--border);
        color: #334155;
      }

      .btn-outline:hover {
        background: var(--accent);
        color: #334155;
        text-decoration: none;
      }

      .toast {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        background: var(--primary);
        color: #fff;
        padding: 0.875rem 1.25rem;
        border-radius: 0.5rem;
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.25);
        transform: translateX(400px);
        opacity: 0;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1000;
        display: flex;
        align-items: center;
        gap: 0.625rem;
        font-size: 0.875rem;
        font-weight: 500;
      }

      .toast i {
        color: #4ade80;
      }

      .toast i.fa-exclamation-circle {
        color: #f87171;
      }

      .toast.show {
        transform: translateX(0);
        opacity: 1;
      }

      .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: var(--muted);
        width: 100%;
        grid-column: 1 / -1;
      }

      .empty-state i {
        font-size: 3rem;
        margin-bottom: 1rem;
        color: var(--muted-2);
      }

      .empty-state h2 {
        color: var(--foreground);
        font-size: 1.125rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
      }

      .empty-state p {
        font-size: 0.875rem;
        color: var(--muted);
      }

      .hidden {
        display: none !important;
      }

      @media (max-width: 768px) {
        .items-grid {
          grid-template-columns: 1fr;
        }

        .header,
        .content,
        .search-container {
          padding-left: 1rem;
          padding-right: 1rem;
        }

        .header-top {
          flex-wrap: wrap;
        }

        .header h1 {
          font-size: 1.125rem;
        }

        .header-actions {
          flex-wrap: wrap;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <div class="header-top">
          <h1>
            <img src="/hostify.png" alt="Hostify" />
            Hostify
          </h1>
          <div class="header-actions">
            <a href="/api/docs" class="btn btn-outline">
              <i class="fas fa-book"></i> API Docs
            </a>
            <a href="https://github.com/InledGroup/hosted.inled.es/releases/latest/download/Hostify-Engine.zip" class="btn btn-outline">
              <i class="fas fa-file-archive"></i> Hostify (.zip)
            </a>
            <button id="openUploadBtn" class="btn btn-primary">
              <i class="fas fa-cloud-upload-alt"></i> Subir
            </button>
          </div>
        </div>
        <div class="breadcrumb" id="breadcrumb">
          <!-- Renderizado por JS -->
        </div>
      </div>

      <div class="search-container">
        <div class="search-wrapper">
          <i class="fas fa-search"></i>
          <input
            type="text"
            id="searchInput"
            class="search-input"
            placeholder="Buscar archivos y carpetas..."
          />
        </div>
      </div>

      <div class="content">
        <div class="items-grid" id="itemsGrid">
          <!-- Renderizado por JS -->
        </div>
      </div>
    </div>

    <div id="toast" class="toast"></div>

    <UploadModal />

    <script is:inline define:vars={{ allItems }}>
      // Estado de la aplicación
      let currentPath = '';
      const fileIndex = allItems;

      // Elementos del DOM
      const itemsGrid = document.getElementById('itemsGrid');
      const breadcrumb = document.getElementById('breadcrumb');
      const searchInput = document.getElementById('searchInput');

      function formatBytes(bytes) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
      }

      function getFileIcon(extension) {
        const icons = {
          '.pdf': 'fa-file-pdf',
          '.txt': 'fa-file-alt',
          '.zip': 'fa-file-archive',
          '.rar': 'fa-file-archive',
          '.mp4': 'fa-file-video',
          '.mov': 'fa-file-video',
          '.webm': 'fa-file-video',
          '.mkv': 'fa-file-video',
          '.avi': 'fa-file-video',
          '.mp3': 'fa-file-audio',
          '.wav': 'fa-file-audio',
          '.doc': 'fa-file-word',
          '.docx': 'fa-file-word',
          '.xls': 'fa-file-excel',
          '.xlsx': 'fa-file-excel',
          '.ppt': 'fa-file-powerpoint',
          '.pptx': 'fa-file-powerpoint',
          '.js': 'fa-file-code',
          '.ts': 'fa-file-code',
          '.jsx': 'fa-file-code',
          '.tsx': 'fa-file-code'
        };
        return icons[extension] || 'fa-file';
      }

      function getFileExtension(name) {
        const idx = name.lastIndexOf('.');
        return idx === -1 ? '' : name.substring(idx).toLowerCase();
      }

      const VIDEO_EXTENSIONS = ['.mp4', '.mov', '.webm', '.mkv', '.avi'];
      const ASSET_RELEASE_TAG = 'assets';

      async function loadReleaseAssets() {
        try {
          // Fuente primaria: índice estático (sin rate-limit, generado por GH Action)
          let remoteItems = null;
          const staticRes = await fetch('/release-assets.json', { cache: 'no-store' });
          if (staticRes.ok) {
            const data = await staticRes.json();
            if (Array.isArray(data.assets) && data.assets.length) {
              remoteItems = data.assets.map(a => ({
                name: a.name,
                type: 'file',
                path: a.name,
                size: a.size,
                isImage: ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.svg', '.bmp', '.ico'].includes(getFileExtension(a.name)),
                isSvg: getFileExtension(a.name) === '.svg',
                extension: getFileExtension(a.name),
                releaseAsset: true,
                _url: '/cdn/' + encodeURIComponent(a.name)
              }));
            }
          }

          // Fallback: API pública (limitada a 60 req/h por IP) por si aún no existe el índice
          if (!remoteItems) {
            const res = await fetch(`https://api.github.com/repos/InledGroup/hosted.inled.es/releases/tags/${ASSET_RELEASE_TAG}`);
            if (res.ok) {
              const assetsRelease = await res.json();
              if (assetsRelease && Array.isArray(assetsRelease.assets)) {
                remoteItems = assetsRelease.assets.map(a => ({
                  name: a.name,
                  type: 'file',
                  path: a.name,
                  size: a.size,
                  isImage: ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.svg', '.bmp', '.ico'].includes(getFileExtension(a.name)),
                  isSvg: getFileExtension(a.name) === '.svg',
                  extension: getFileExtension(a.name),
                  releaseAsset: true,
                  _url: '/cdn/' + encodeURIComponent(a.name)
                }));
              }
            }
          }

          if (remoteItems && remoteItems.length) {
            fileIndex.push(...remoteItems);
            updateView();
          }
        } catch (e) {
          console.warn('No se pudieron cargar los assets de la release:', e);
        }
      }

      function renderBreadcrumb() {
        let html = `<a onclick="navigateTo('')"><i class="fas fa-home"></i> Public</a>`;
        
        if (currentPath) {
          const parts = currentPath.split('/');
          let pathAccumulator = '';
          parts.forEach((part, index) => {
            pathAccumulator += (index === 0 ? '' : '/') + part;
            html += `
              <span class="separator"><i class="fas fa-chevron-right"></i></span>
              <a onclick="navigateTo('${pathAccumulator}')">${part}</a>
            `;
          });
        }
        breadcrumb.innerHTML = html;
      }

      function renderFiles(items) {
        if (items.length === 0) {
          itemsGrid.innerHTML = `
            <div class="empty-state">
              <i class="fas fa-inbox"></i>
              <h2>No hay archivos aquí</h2>
              <p>Esta carpeta está vacía</p>
            </div>
          `;
          return;
        }

        itemsGrid.innerHTML = items.map(item => {
          const isFolder = item.type === 'folder';
          // En Cloudflare Pages, todos los archivos estáticos de public/ están bajo la raíz, 
          // y la regla de redirección /* -> /1/:splat se encarga de buscarlos en /1/
          const publicPath = `/${item.path}`;
          
          const isVideo = VIDEO_EXTENSIONS.includes(getFileExtension(item.name));
          const isReleaseAsset = !!item.releaseAsset;
          const linkUrl = isReleaseAsset ? item._url : publicPath;
          const previewSrc = item.isSvg && isReleaseAsset ? '/preview/' + encodeURIComponent(item.name) : linkUrl;
          const copyUrlFor = isReleaseAsset ? `https://hosted.inled.es${item._url}` : '';
          const preview = isFolder
            ? `<i class="fas fa-folder folder-icon"></i>`
            : item.isImage
              ? `<img src="${previewSrc}" alt="${item.name}" loading="lazy" style="object-fit: contain; background: var(--accent, #f1f5f9); width: 100%; height: 100%;" />`
              : isVideo
                ? `<video src="${linkUrl}" preload="metadata" muted playsinline style="width:100%; height:100%; object-fit:contain; background:#020617;"></video>`
                : `<i class="fas ${getFileIcon(item.extension)} file-icon"></i>`;

          const sizeLabel = item.type === 'folder'
            ? '<i class="fas fa-folder"></i> Carpeta'
            : `<i class="fas fa-database"></i> ${formatBytes(item.size)} <span style="margin: 0 0.25rem;">•</span> ${item.extension.slice(1).toUpperCase()} ${isReleaseAsset ? ' <span class="release-badge"><i class="fas fa-rocket"></i> Release</span>' : ''}`;

          return `
            <div class="item" data-name="${item.name.toLowerCase()}" data-type="${item.type}">
              <div class="item-preview">
                ${preview}
              </div>
              <div class="item-body">
                <div class="item-info">
                  <div class="item-name">${item.name}</div>
                  <div class="item-details">
                    ${sizeLabel}
                  </div>
                </div>
                <div class="item-actions">
                  ${isFolder ? 
                    `<button class="btn btn-primary" onclick="navigateTo('${item.path}')">
                      <i class="fas fa-folder-open"></i> Abrir
                    </button>` : 
                    `<button class="btn btn-primary" onclick="copyUrl('${publicPath}', ${!!item.releaseAsset}, '${copyUrlFor}')">
                      <i class="fas fa-copy"></i> Copiar
                    </button>
                    <a href="${linkUrl}" download="${item.name}" class="btn btn-outline" style="text-decoration: none;">
                      <i class="fas fa-download"></i>
                    </a>
                    <a href="${linkUrl}" target="_blank" class="btn btn-outline" style="text-decoration: none;">
                      <i class="fas fa-external-link-alt"></i> Ver
                    </a>`
                  }
                </div>
              </div>
            </div>
          `;
        }).join('');
      }

      function updateView() {
        const normalizedPath = currentPath.replace(/\\/g, '/');
        let filteredItems = [];

        if (!normalizedPath) {
          // Raíz
          filteredItems = fileIndex.filter(item => !item.path.includes('/'));
        } else {
          // Subcarpeta
          const prefix = normalizedPath + '/';
          filteredItems = fileIndex.filter(item => {
            if (!item.path.startsWith(prefix)) return false;
            const relativePath = item.path.substring(prefix.length);
            return !relativePath.includes('/');
          });
        }

        // Ordenar: carpetas primero
        filteredItems.sort((a, b) => {
          if (a.type === 'folder' && b.type !== 'folder') return -1;
          if (a.type !== 'folder' && b.type === 'folder') return 1;
          return a.name.localeCompare(b.name);
        });

        renderBreadcrumb();
        renderFiles(filteredItems);
        
        // Actualizar input oculto del modal de subida si existe
        const modalPathInput = document.querySelector('#uploadModal input[name="path"]');
        if (modalPathInput) modalPathInput.value = currentPath || '1';
      }

      function navigateTo(path) {
        currentPath = path;
        const url = new URL(window.location);
        if (path) {
          url.searchParams.set('path', path);
        } else {
          url.searchParams.delete('path');
        }
        window.history.pushState({}, '', url);
        updateView();
        // Resetear búsqueda al navegar
        if (searchInput) searchInput.value = '';
      }

      function copyUrl(url, isRelease, releaseUrl) {
        const fullUrl = isRelease ? releaseUrl : ('https://hosted.inled.es' + url);
        navigator.clipboard.writeText(fullUrl).then(() => {
          showToast('<i class="fas fa-check-circle"></i> URL copiada al portapapeles');
        }).catch(() => {
          showToast('<i class="fas fa-exclamation-circle"></i> Error al copiar la URL');
        });
      }

      function showToast(message) {
        const toast = document.getElementById('toast');
        if (toast) {
          toast.innerHTML = message;
          toast.classList.add('show');
          setTimeout(() => {
            toast.classList.remove('show');
          }, 3000);
        }
      }

      // Eventos Globales
      window.navigateTo = navigateTo;
      window.copyUrl = copyUrl;
      window.showToast = showToast;

      // Manejar botón atrás del navegador
      window.addEventListener('popstate', () => {
        const params = new URLSearchParams(window.location.search);
        currentPath = params.get('path') || '';
        updateView();
      });

      // Inicialización
      document.addEventListener('DOMContentLoaded', () => {
        const params = new URLSearchParams(window.location.search);
        currentPath = params.get('path') || '';
        updateView();
        loadReleaseAssets();

        if (searchInput) {
          searchInput.addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase().trim();
            
            if (!searchTerm) {
              updateView(); // Volver a la carpeta actual si no hay búsqueda
              return;
            }

            // BÚSQUEDA GLOBAL: Buscar en todo el índice de archivos
            const foundItems = fileIndex.filter(item => 
              item.name.toLowerCase().includes(searchTerm) || 
              item.path.toLowerCase().includes(searchTerm)
            );

            // Mostrar resultados
            if (foundItems.length > 0) {
              breadcrumb.innerHTML = `<span><i class="fas fa-search"></i> Resultados para: "${searchTerm}"</span>`;
              renderFiles(foundItems);
            } else {
              itemsGrid.innerHTML = `
                <div class="empty-state">
                  <i class="fas fa-search"></i>
                  <h2>No se encontró nada</h2>
                  <p>No hay archivos que coincidan con "${searchTerm}"</p>
                </div>
              `;
            }
          });
        }
      });
    </script>
  </body>
</html>