---
import fileIndex from '../data/file-index.json';
import UploadModal from '../components/UploadModal.astro';

export const prerender = true;

// Ya no filtramos en el servidor, solo pasamos el índice al cliente
const allItems = fileIndex;

function formatBytes(bytes: number): string {
  if (bytes === 0) return '0 Bytes';
  const k = 1024;
  const sizes = ['Bytes', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hostify</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style is:global>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0a0e27;
      padding: 0;
      line-height: 1.6;
      min-height: 100vh;
    }

    .container {
      max-width: 1600px;
      margin: 0 auto;
      min-height: 100vh;
      background: #0f1420;
    }

    .header {
      background: linear-gradient(135deg, #0f1420 0%, #1a1f3a 100%);
      border-bottom: 1px solid rgba(61, 182, 255, 0.1);
      padding: 2rem 3rem;
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(10px);
    }

    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      gap: 1.5rem;
    }

    .header-actions {
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .header h1 {
      font-size: 1.75rem;
      font-weight: 700;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0;
    }

    .header h1 i {
      color: #3db6ff;
      font-size: 1.5rem;
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      color: #8b92b0;
    }

    .breadcrumb a {
      color: #8b92b0;
      text-decoration: none;
      padding: 0.375rem 0.75rem;
      border-radius: 6px;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
    }

    .breadcrumb a:hover {
      background: rgba(61, 182, 255, 0.1);
      color: #3db6ff;
    }

    .breadcrumb .separator {
      color: #4a5172;
    }

    .search-container {
      padding: 1.5rem 3rem;
      background: #0f1420;
      border-bottom: 1px solid rgba(61, 182, 255, 0.05);
    }

    .search-wrapper {
      position: relative;
      max-width: 600px;
    }

    .search-wrapper i {
      position: absolute;
      left: 1.25rem;
      top: 50%;
      transform: translateY(-50%);
      color: #4a5172;
      font-size: 1rem;
    }

    .search-input {
      width: 100%;
      padding: 1rem 1rem 1rem 3rem;
      font-size: 0.9375rem;
      background: #1a1f3a;
      border: 1px solid rgba(61, 182, 255, 0.2);
      border-radius: 12px;
      color: #fff;
      outline: none;
      transition: all 0.3s ease;
    }

    .search-input::placeholder {
      color: #4a5172;
    }

    .search-input:focus {
      border-color: #3db6ff;
      box-shadow: 0 0 0 3px rgba(61, 182, 255, 0.1);
      background: #1f2540;
    }

    .content {
      padding: 2rem 3rem 3rem;
    }

    .items-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .item {
      background: #1a1f3a;
      border: 1px solid rgba(61, 182, 255, 0.1);
      border-radius: 16px;
      padding: 0;
      overflow: hidden;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
      position: relative;
    }

    .item::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(135deg, rgba(61, 182, 255, 0.05) 0%, transparent 100%);
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }

    .item:hover {
      transform: translateY(-8px);
      border-color: #3db6ff;
      box-shadow: 0 20px 40px rgba(61, 182, 255, 0.15);
    }

    .item:hover::before {
      opacity: 1;
    }

    .item.hidden {
      display: none;
    }

    .item-preview {
      width: 100%;
      height: 200px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0f1420;
      overflow: hidden;
      position: relative;
    }

    .item-preview::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(61, 182, 255, 0.3), transparent);
    }

    .item-preview img {
      max-width: 100%;
      max-height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .item:hover .item-preview img {
      transform: scale(1.05);
    }

    .folder-icon, .file-icon {
      font-size: 3.5rem;
      color: #3db6ff;
      opacity: 0.4;
      transition: all 0.3s ease;
    }

    .item:hover .folder-icon,
    .item:hover .file-icon {
      opacity: 0.8;
      transform: scale(1.1);
    }

    .item-body {
      padding: 1.25rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .item-info {
      flex: 1;
      margin-bottom: 1rem;
    }

    .item-name {
      font-weight: 600;
      margin-bottom: 0.5rem;
      word-break: break-word;
      color: #e4e7f1;
      font-size: 0.9375rem;
      line-height: 1.4;
    }

    .item-details {
      font-size: 0.8125rem;
      color: #6b7396;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .item-details i {
      font-size: 0.75rem;
      color: #3db6ff;
    }

    .item-actions {
      display: flex;
      gap: 0.625rem;
    }

    .item-actions .btn {
      flex: 1;
    }

    .btn {
      padding: 0.625rem 1rem;
      border: none;
      border-radius: 8px;
      font-size: 0.875rem;
      cursor: pointer;
      transition: all 0.2s ease;
      font-weight: 500;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }

    .btn i {
      font-size: 0.875rem;
    }

    .btn-primary {
      background: #3db6ff;
      color: #fff;
      position: relative;
      overflow: hidden;
    }

    .btn-primary:hover {
      background: #2da3e8;
      box-shadow: 0 8px 20px rgba(61, 182, 255, 0.4);
      transform: translateY(-2px);
    }

    .btn-secondary {
      background: rgba(61, 182, 255, 0.1);
      color: #3db6ff;
      border: 1px solid rgba(61, 182, 255, 0.2);
    }

    .btn-secondary:hover {
      background: rgba(61, 182, 255, 0.2);
      border-color: #3db6ff;
    }

    .toast {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: linear-gradient(135deg, #1a1f3a 0%, #252b4a 100%);
      color: #fff;
      padding: 1rem 1.5rem;
      border-radius: 12px;
      border: 1px solid rgba(61, 182, 255, 0.3);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
      transform: translateX(400px);
      opacity: 0;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 1000;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .toast i {
      color: #3db6ff;
    }

    .toast.show {
      transform: translateX(0);
      opacity: 1;
    }

    .empty-state {
      text-align: center;
      padding: 5rem 2rem;
      color: #6b7396;
      width: 100%;
    }

    .empty-state i {
      font-size: 4rem;
      margin-bottom: 1.5rem;
      color: #3db6ff;
      opacity: 0.3;
    }

    .empty-state h2 {
      color: #e4e7f1;
      margin-bottom: 0.5rem;
    }

    .hidden {
      display: none !important;
    }

    @media (max-width: 768px) {
      .items-grid {
        grid-template-columns: 1fr;
      }

      .header, .content, .search-container {
        padding: 1.5rem;
      }

      .header h1 {
        font-size: 1.5rem;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="header-top">
        <h1><i class="fas fa-rocket"></i> Hostify</h1>
        <div class="header-actions">
          <a href="/api/docs" class="btn btn-secondary" style="width: auto; padding: 0.75rem 1.5rem; text-decoration: none;">
            <i class="fas fa-book"></i> API Docs
          </a>
          <a href="https://github.com/InledGroup/hosted.inled.es/releases/latest/download/Hostify-Engine.zip" class="btn btn-secondary" style="width: auto; padding: 0.75rem 1.5rem; text-decoration: none;">
            <i class="fas fa-file-archive"></i> Hostify (.zip)
          </a>
          <button id="openUploadBtn" class="btn btn-primary" style="width: auto; padding: 0.75rem 1.5rem;">
            <i class="fas fa-cloud-upload-alt"></i> Subir
          </button>
        </div>
      </div>
      <div class="breadcrumb" id="breadcrumb">
        <!-- Renderizado por JS -->
      </div>
    </div>

    <div class="search-container">
      <div class="search-wrapper">
        <i class="fas fa-search"></i>
        <input
          type="text"
          id="searchInput"
          class="search-input"
          placeholder="Buscar archivos y carpetas..."
        />
      </div>
    </div>

    <div class="content">
      <div class="items-grid" id="itemsGrid">
        <!-- Renderizado por JS -->
      </div>
    </div>
  </div>

  <div id="toast" class="toast"></div>

  <UploadModal />

  <script is:inline define:vars={{ allItems }}>
    // Estado de la aplicación
    let currentPath = '';
    const fileIndex = allItems;

    // Elementos del DOM
    const itemsGrid = document.getElementById('itemsGrid');
    const breadcrumb = document.getElementById('breadcrumb');
    const searchInput = document.getElementById('searchInput');

    function formatBytes(bytes) {
      if (bytes === 0) return '0 Bytes';
      const k = 1024;
      const sizes = ['Bytes', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
    }

    function getFileIcon(extension) {
      const icons = {
        '.pdf': 'fa-file-pdf',
        '.txt': 'fa-file-alt',
        '.zip': 'fa-file-archive',
        '.rar': 'fa-file-archive',
        '.mp4': 'fa-file-video',
        '.mov': 'fa-file-video',
        '.mp3': 'fa-file-audio',
        '.wav': 'fa-file-audio',
        '.doc': 'fa-file-word',
        '.docx': 'fa-file-word',
        '.xls': 'fa-file-excel',
        '.xlsx': 'fa-file-excel',
        '.ppt': 'fa-file-powerpoint',
        '.pptx': 'fa-file-powerpoint',
        '.js': 'fa-file-code',
        '.ts': 'fa-file-code',
        '.jsx': 'fa-file-code',
        '.tsx': 'fa-file-code'
      };
      return icons[extension] || 'fa-file';
    }

    function renderBreadcrumb() {
      let html = `<a onclick="navigateTo('')"><i class="fas fa-home"></i> Public</a>`;
      
      if (currentPath) {
        const parts = currentPath.split('/');
        let pathAccumulator = '';
        parts.forEach((part, index) => {
          pathAccumulator += (index === 0 ? '' : '/') + part;
          html += `
            <span class="separator"><i class="fas fa-chevron-right"></i></span>
            <a onclick="navigateTo('${pathAccumulator}')">${part}</a>
          `;
        });
      }
      breadcrumb.innerHTML = html;
    }

    function renderFiles(items) {
      if (items.length === 0) {
        itemsGrid.innerHTML = `
          <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <h2>No hay archivos aquí</h2>
            <p>Esta carpeta está vacía</p>
          </div>
        `;
        return;
      }

      itemsGrid.innerHTML = items.map(item => {
        const isFolder = item.type === 'folder';
        // En Cloudflare Pages, todos los archivos estáticos de public/ están bajo la raíz, 
        // pero tu estructura de datos parece esperar que estén en /1/
        const publicPath = `/1/${item.path}`;
        
        return `
          <div class="item" data-name="${item.name.toLowerCase()}" data-type="${item.type}">
            <div class="item-preview">
              ${isFolder ? 
                `<i class="fas fa-folder folder-icon"></i>` : 
                (item.isImage ? 
                  `<img src="${publicPath}" alt="${item.name}" loading="lazy" style="object-fit: contain; background: #0a0e27; width: 100%; height: 100%;" />` : 
                  `<i class="fas ${getFileIcon(item.extension)} file-icon"></i>`
                )
              }
            </div>
            <div class="item-body">
              <div class="item-info">
                <div class="item-name">${item.name}</div>
                <div class="item-details">
                  ${isFolder ? 
                    `<i class="fas fa-folder"></i> Carpeta` : 
                    `<i class="fas fa-database"></i> ${formatBytes(item.size)} <span style="margin: 0 0.25rem;">•</span> ${item.extension.slice(1).toUpperCase()}`
                  }
                </div>
              </div>
              <div class="item-actions">
                ${isFolder ? 
                  `<button class="btn btn-primary" onclick="navigateTo('${item.path}')">
                    <i class="fas fa-folder-open"></i> Abrir
                  </button>` : 
                  `<button class="btn btn-primary" onclick="copyUrl('${publicPath}')">
                    <i class="fas fa-copy"></i> Copiar
                  </button>
                  <a href="${publicPath}" target="_blank" class="btn btn-secondary" style="text-decoration: none; text-align: center;">
                    <i class="fas fa-external-link-alt"></i> Ver
                  </a>`
                }
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function updateView() {
      const normalizedPath = currentPath.replace(/\\/g, '/');
      let filteredItems = [];

      if (!normalizedPath) {
        // Raíz
        filteredItems = fileIndex.filter(item => !item.path.includes('/'));
      } else {
        // Subcarpeta
        const prefix = normalizedPath + '/';
        filteredItems = fileIndex.filter(item => {
          if (!item.path.startsWith(prefix)) return false;
          const relativePath = item.path.substring(prefix.length);
          return !relativePath.includes('/');
        });
      }

      // Ordenar: carpetas primero
      filteredItems.sort((a, b) => {
        if (a.type === 'folder' && b.type !== 'folder') return -1;
        if (a.type !== 'folder' && b.type === 'folder') return 1;
        return a.name.localeCompare(b.name);
      });

      renderBreadcrumb();
      renderFiles(filteredItems);
      
      // Actualizar input oculto del modal de subida si existe
      const modalPathInput = document.querySelector('#uploadModal input[name="path"]');
      if (modalPathInput) modalPathInput.value = currentPath || '1';
    }

    function navigateTo(path) {
      currentPath = path;
      const url = new URL(window.location);
      if (path) {
        url.searchParams.set('path', path);
      } else {
        url.searchParams.delete('path');
      }
      window.history.pushState({}, '', url);
      updateView();
      // Resetear búsqueda al navegar
      if (searchInput) searchInput.value = '';
    }

    function copyUrl(url) {
      const fullUrl = window.location.origin + url;
      navigator.clipboard.writeText(fullUrl).then(() => {
        showToast('<i class="fas fa-check-circle"></i> URL copiada al portapapeles');
      }).catch(() => {
        showToast('<i class="fas fa-exclamation-circle"></i> Error al copiar la URL');
      });
    }

    function showToast(message) {
      const toast = document.getElementById('toast');
      if (toast) {
        toast.innerHTML = message;
        toast.classList.add('show');
        setTimeout(() => {
          toast.classList.remove('show');
        }, 3000);
      }
    }

    // Eventos Globales
    window.navigateTo = navigateTo;
    window.copyUrl = copyUrl;
    window.showToast = showToast;

    // Manejar botón atrás del navegador
    window.addEventListener('popstate', () => {
      const params = new URLSearchParams(window.location.search);
      currentPath = params.get('path') || '';
      updateView();
    });

    // Inicialización
    document.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      currentPath = params.get('path') || '';
      updateView();

      if (searchInput) {
        searchInput.addEventListener('input', function() {
          const searchTerm = this.value.toLowerCase().trim();
          
          if (!searchTerm) {
            updateView(); // Volver a la carpeta actual si no hay búsqueda
            return;
          }

          // BÚSQUEDA GLOBAL: Buscar en todo el índice de archivos
          const foundItems = fileIndex.filter(item => 
            item.name.toLowerCase().includes(searchTerm) || 
            item.path.toLowerCase().includes(searchTerm)
          );

          // Mostrar resultados
          if (foundItems.length > 0) {
            breadcrumb.innerHTML = `<span><i class="fas fa-search"></i> Resultados para: "${searchTerm}"</span>`;
            renderFiles(foundItems);
          } else {
            itemsGrid.innerHTML = `
              <div class="empty-state">
                <i class="fas fa-search"></i>
                <h2>No se encontró nada</h2>
                <p>No hay archivos que coincidan con "${searchTerm}"</p>
              </div>
            `;
          }
        });
      }
    });
  </script>
</body>
</html>
